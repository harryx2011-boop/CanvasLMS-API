# Your school's Canvas host. No /api/v1 suffix needed.
CANVAS_URL=https://yourschool.instructure.com

# Personal access token: Canvas > Account > Settings > Approved Integrations > New Access Token
CANVAS_TOKEN=

# Optional
CANVAS_TIMEOUT=30
CANVAS_CACHE_TTL=300
CANVAS_MAX_CONCURRENCY=5
CANVAS_ANONYMIZE_STUDENTS=false
CANVAS_DOWNLOAD_DIR=
